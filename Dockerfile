# Используем стабильную версию Node.js
FROM node:20-alpine

# Создаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файлы зависимостей
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install --production

# Копируем весь остальной код проекта
COPY . .

# Открываем порт (замените 3000 на порт, который использует ваше JS-приложение)
EXPOSE 3000

# Команда для запуска приложения (обычно берется из секции "start" в package.json)
CMD ["npm", "start"]